# Copy to .env (git-ignored). Only needed for the LLM providers; the local provider needs nothing.

# local | anthropic | openai
MODEL_PROVIDER=local
# Optional model override, e.g. claude-haiku-5-5 or gpt-4o-mini
# MODEL_NAME=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional tuning
# DEFAULT_MODE=classify
# CONCURRENCY=5
# MAX_INPUT_CHARS=2000
# REQUEST_TIMEOUT_MS=10000
# MAX_RETRIES=2
# CACHE_SIZE=1000
